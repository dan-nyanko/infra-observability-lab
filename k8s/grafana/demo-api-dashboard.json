{
  "id": null,
  "title": "Demo-API Incident Simulation",
  "tags": ["observability", "incident", "demo-api"],
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "panels": [
    {
      "type": "graph",
      "title": "Request Rate",
      "targets": [
      {
        "expr": "rate(http_requests_total[1m])",
        "legendFormat": "{{version}}"
      }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 1
    },
    {
      "type": "graph",
      "title": "Error Rate (500s)",
      "targets": [
      {
        "expr": "rate(http_requests_total{status=\"500\"}[1m])",
        "legendFormat": "{{pod}}"
      }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 2
    },
    {
      "type": "graph",
      "title": "Latency (95th Percentile)",
      "targets": [
      {
        "expr": "histogram_quantile(0.95, rate(http_request_latency_seconds_bucket[5m]))",
        "legendFormat": "{{version}}"
      }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 3
    },
    {
      "type": "graph",
      "title": "Slow Requests",
      "targets": [
      {
        "expr": "rate(slow_requests_total[5m])",
        "legendFormat": "{{version}}"
      }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 4
    },
    {
      "type": "graph",
      "title": "Pod Restarts",
      "targets": [
      {
        "expr": "increase(kube_pod_container_status_restarts_total[5m])",
        "legendFormat": "{{pod}}"
      }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 5
    },
    {
      "type": "graph",
      "title": "CPU Throttling",
      "targets": [
      {
        "expr": "rate(container_cpu_cfs_throttled_seconds_total[5m])",
        "legendFormat": "{{pod}}"
      }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 6
    },
    {
      "type": "graph",
      "title": "Memory Usage",
      "targets": [
      {
        "expr": "container_memory_working_set_bytes",
        "legendFormat": "{{pod}}"
      }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 7
    }
  ]
}